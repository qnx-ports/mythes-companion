# Alpine-Contributor: Timo Teräs <timo.teras@iki.fi>
# Alpine-Maintainer: Timo Teräs <timo.teras@iki.fi>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=mythes
pkgver=1.2.4
pkgrel=${pkgrel:-0}
pkgdesc="A simple thesaurus"
url="https://hunspell.sourceforge.net/"
arch="all"
license="GPL-2.0-or-later LGPL-2.0-or-later MPL-1.1"
subpackages="$pkgname-dev"
depends="libc++"
depends_dev="perl hunspell-dev clang libc++-dev"
makedepends="$depends_dev"
source="https://downloads.sourceforge.net/hunspell/$pkgname-$pkgver.tar.gz"

prepare() {
	default_prepare

	update_config_sub
	update_config_guess
}

build() {
    CC=clang \
    CXX=clang++ \
    CFLAGS="$CFLAGS -Qunused-arguments" \
    CXXFLAGS="$CXXFLAGS -Qunused-arguments" \
    CPPFLAGS="$CPPFLAGS -Qunused-arguments" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--disable-static \
		--disable-dependency-tracking \
		--enable-fast-install
	make
}

check() {
	make check
}

package() {
	make -j1 DESTDIR="$pkgdir" install
}

dev() {
	default_dev

	amove usr/bin
}

options="$options ${DISABLE_CHECK:+!check}"
sha512sums="
a04da39812bcfb1391a2cba7de73e955eafe141679ec03ed6657d03bebf360b432480d0037dff9ed72a1dfda5a70d77d44ac2bb14cdb109fd8e2a38376feee21  mythes-1.2.4.tar.gz
"
